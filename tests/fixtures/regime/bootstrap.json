{
  "test_cases": [
    {
      "name": "stable_theta_cv_le_030",
      "description": "Bootstrap CV ≤ 0.30 (θ estável)",
      "thetas": [0.1, 0.12, 0.09, 0.11, 0.08, 0.13, 0.1, 0.11, 0.09, 0.12],
      "expected": {
        "status": "PASS",
        "is_stable": true,
        "forca_penalty_cv": false,
        "cv_threshold": 0.30
      }
    },
    {
      "name": "unstable_theta_cv_gt_030",
      "description": "Bootstrap CV > 0.30 (flag penalização)",
      "thetas": [0.05, 0.25, 0.08, 0.18, 0.12, 0.22, 0.09, 0.19, 0.11, 0.21],
      "expected": {
        "status": "PASS",
        "is_stable": false,
        "forca_penalty_cv": true
      }
    },
    {
      "name": "mu_theta_aprox_zero",
      "description": "Bootstrap μ_θ ≈ 0 (NEUTRO)",
      "thetas": [0.001, -0.002, 0.0005, -0.001, 0.002, -0.0005, 0.001, -0.001, 0.0008, -0.0003],
      "expected": {
        "status": "NEUTRO",
        "mu_threshold": 0.05
      }
    },
    {
      "name": "single_theta",
      "description": "Bootstrap com único θ",
      "thetas": [0.15],
      "expected": {
        "status": "PASS",
        "cv_theta": 0.0,
        "is_stable": true
      }
    },
    {
      "name": "empty_thetas",
      "description": "Bootstrap com lista vazia",
      "thetas": [],
      "expected": {
        "status": "NEUTRO"
      }
    }
  ]
}