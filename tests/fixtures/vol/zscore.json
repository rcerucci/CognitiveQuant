{
  "test_cases": [
    {
      "name": "zscore_basic_calculation",
      "description": "Cálculo básico Z = (X - μ) / σ",
      "X_t": 0.005,
      "mu_t": 0.001,
      "sigma_t": 0.02,
      "expected": {
        "status": "PASS",
        "z_t": 0.2
      }
    },
    {
      "name": "zscore_positive_X",
      "description": "X > μ resulta em Z positivo",
      "X_t": 0.01,
      "mu_t": 0.002,
      "sigma_t": 0.02,
      "expected": {
        "status": "PASS",
        "z_t": 0.4
      }
    },
    {
      "name": "zscore_negative_X",
      "description": "X < μ resulta em Z negativo",
      "X_t": -0.005,
      "mu_t": 0.001,
      "sigma_t": 0.02,
      "expected": {
        "status": "PASS",
        "z_t": -0.3
      }
    },
    {
      "name": "zscore_sigma_zero",
      "description": "σ = 0 resulta em NEUTRO",
      "X_t": 0.001,
      "mu_t": 0.001,
      "sigma_t": 0.0,
      "expected": {
        "status": "NEUTRO",
        "reason": "invalid_sigma_non_positive"
      }
    },
    {
      "name": "zscore_sigma_negative",
      "description": "σ < 0 resulta em NEUTRO",
      "X_t": 0.001,
      "mu_t": 0.001,
      "sigma_t": -0.01,
      "expected": {
        "status": "NEUTRO",
        "reason": "invalid_sigma_non_positive"
      }
    },
    {
      "name": "zscore_sigma_infinity",
      "description": "σ = inf resulta em NEUTRO",
      "X_t": 0.001,
      "mu_t": 0.001,
      "sigma_t": 1e308,
      "expected": {
        "status": "NEUTRO",
        "reason": "invalid_sigma_not_finite"
      }
    },
    {
      "name": "zscore_mu_nan",
      "description": "μ = NaN resulta em NEUTRO",
      "X_t": 0.001,
      "mu_t": null,
      "sigma_t": 0.01,
      "expected": {
        "status": "NEUTRO",
        "reason": "invalid_mu_not_finite"
      }
    },
    {
      "name": "zscore_X_nan",
      "description": "X_t = NaN resulta em NEUTRO",
      "X_t": null,
      "mu_t": 0.001,
      "sigma_t": 0.01,
      "expected": {
        "status": "NEUTRO",
        "reason": "invalid_X_t_not_finite"
      }
    }
  ]
}